[Unit]
Description=firerunner EC2 JIT runner (one job, then power off)
# No network-online.target or docker ordering: the script retries until the
# VPC endpoint answers, which is earlier than either.
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/usr/local/bin/firerunner-ec2-run.sh
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=0
# The default, stated because firerunner-ec2-run.sh relies on it: a broken
# journal stream fails writes (EPIPE) instead of killing the script before it
# reports the runner's exit and powers off.
IgnoreSIGPIPE=yes
# A job's process killed for memory fails its step. It must not stop this
# unit, the default: the script would take SIGTERM for the instance going away
# and leave it running, billed, with nothing to power it off.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target

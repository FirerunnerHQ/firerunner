# firerunner configuration (environment form). Flags of the same name override.
# Copy to /etc/firerunner/firerunner.env and edit. This file holds credentials
# (FR_TOKEN and/or the App private-key path), so keep it non-world-readable:
#   sudo install -m0640 -o root -g firerunner config.example.env \
#     /etc/firerunner/firerunner.env

# --- GitHub scale set ---
FR_URL=https://github.com/ORG/REPO
FR_NAME=firerunner
FR_RUNNER_GROUP=default
FR_LABELS=
FR_MAX_RUNNERS=4
# Warm pool: microVMs kept pre-booted and already "Listening for Jobs" so a
# queued job is picked up without waiting for a cold boot + runner connect.
# 0 = pure on-demand (lowest idle cost). Each warm runner holds FR_VCPU/FR_MEM_MIB
# while idle; raise it to cut pickup latency on interactive CI.
FR_MIN_RUNNERS=0

# --- Auth (prefer a GitHub App over a PAT) ---
# FR_TOKEN=ghp_...
FR_APP_CLIENT_ID=
FR_APP_INSTALLATION_ID=
FR_APP_PRIVATE_KEY=/etc/firerunner/app-key.pem

# --- microVM shape ---
FR_VCPU=4
FR_MEM_MIB=8192

# --- runner tiers (optional) ---
# Serve several developer-selectable tiers (each its own runs-on name, microVM
# shape and golden image) from one process. FR_MAX_RUNNERS is the shared slot
# budget across all tiers. When unset, a single tier is derived from the fields
# above. See examples/tiers.json.
# FR_TIERS=/etc/firerunner/tiers.json

# --- Firecracker ---
FR_FIRECRACKER_BIN=firecracker
FR_KERNEL=/var/lib/firerunner/vmlinux
FR_GOLDEN=/var/lib/firerunner/golden.ext4
FR_WORKDIR=/var/tmp/firerunner

# --- networking & logs ---
# Host external interface used for microVM egress NAT (required).
FR_EXT_IFACE=enp2s0
# Directory for per-runner console logs (off-VM log forwarding). Optional.
FR_LOG_DIR=/var/log/firerunner

# --- egress allowlist ---
# Comma-separated allowlist. GitHub /meta categories: api,actions,git,packages.
# Pseudo-categories: dns (allow resolvers), ntp (allow time sync). Use "open" to
# disable the allowlist and fall back to blanket NAT.
FR_EGRESS=api,actions,git,dns,packages,ntp
# Resolver IPs the guests are permitted to reach on port 53.
FR_DNS_SERVERS=1.1.1.1,8.8.8.8
# How often to re-fetch GitHub's /meta ranges. 0 disables periodic refresh.
FR_META_REFRESH=24h

# --- hardening: Firecracker jailer (opt-in) ---
# firerunner already runs non-root and Firecracker installs seccomp filters by
# default, so the jailer is an incremental defence-in-depth step: it chroots each
# microVM, gives it a private PID namespace and drops it to an unprivileged
# uid/gid. No network namespace is used, so the tap networking is unchanged.
# Cost: the launcher must run as root (to chroot/mknod/drop privileges), so this
# is off by default. Turn it on for multi-tenant / untrusted-code / shared hosts.
# FR_JAILER=true
# FR_JAILER_BIN=jailer
# FR_CHROOT_BASE=/srv/jailer
# uid/gid the jailer drops Firecracker to (required when FR_JAILER=true):
# FR_JAIL_UID=955
# FR_JAIL_GID=954
# Optional per-VM cgroup v2 limits (jailer only), semicolon-separated
# <file>=<value>; caps one microVM's resource use on a shared host. Use ';'
# because cgroup values like cpuset.cpus=0-3,5 contain commas.
# FR_JAILER_CGROUP=memory.max=2147483648;cpu.max=200000;pids.max=512
# Optional per-VM network namespace (jailer only): puts each microVM's tap in
# its own netns for the strongest network isolation (guest sees only a veth
# uplink, not the host's other taps/routes). Requires FR_JAILER=true.
# FR_NETNS=true

# --- pre-seeded tool cache (opt-in) ---
# Read-only ext4 image mirroring GitHub's hosted tool-cache layout (e.g.
# go/<ver>/x64/ + x64.complete) and labelled "hostedtoolcache". Attached to every
# microVM as a shared read-only drive and mounted at /opt/hostedtoolcache so
# setup-* actions hit the cache instead of downloading. Pure accelerator: when
# unset, or when a version is not in the image, setup-* downloads as usual.
# FR_TOOLCACHE=/var/lib/firerunner/toolcache-go.ext4

# --- self-hosted dependency cache (opt-in) ---
# Keep actions/cache archives (pnpm/go/pip/setup-* caches) on the host's local
# disk instead of GitHub's hosted cache, for LAN-speed restore with no quota.
# Run the server separately: `firerunner cache-server --dir /var/lib/firerunner/cache`.
# FR_CACHE_PORT is the server's port; microVMs reach it on their host gateway.
# Requires a golden built with `build-ubuntu-rootfs.sh --cache-redirect`.
# FR_CACHE_PORT=8099
# For a different address on this same host, give an explicit URL instead. The
# cache-server must share this daemon's jobs directory and see each guest's
# source IP unchanged; a remote server behind SNAT or a proxy denies every job.
# FR_CACHE_URL=http://host:8099

# --- logging ---
FR_LOG_LEVEL=info
FR_LOG_FORMAT=text
